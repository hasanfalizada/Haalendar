# +++===+++ 2026-10-14 — Hasan Alizada — HAAL-006. Editor-independent formatting baseline (https://editorconfig.org). Language formatters (added with the stack) must agree with it.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.md]
# Two trailing spaces are a hard line break in Markdown
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{bat,cmd}]
end_of_line = crlf
