# +++===+++ 2026-10-14 — Hasan Alizada — HAAL-016. Documented configuration. Copy to .env (never commit .env).
# Every secret may instead be provided as <NAME>_FILE=/run/secrets/<file> (Docker secrets).

# development | test | production  (production refuses insecure defaults)
HAALENDAR_ENV=development

# PostgreSQL 18 (SQLAlchemy URL with the psycopg 3 driver)
HAALENDAR_DATABASE_URL=postgresql+psycopg://haalendar:haalendar@localhost:5432/haalendar
HAALENDAR_DB_POOL_SIZE=5
HAALENDAR_DB_MAX_OVERFLOW=5
HAALENDAR_DB_POOL_TIMEOUT_SECONDS=5
HAALENDAR_DB_CONNECT_TIMEOUT_SECONDS=5

# Random value, at least 32 characters, required in production. Example: openssl rand -base64 48
HAALENDAR_SECRET_KEY=

# External URL of the instance; must be https:// in production (enables HSTS)
HAALENDAR_PUBLIC_URL=http://localhost:8080

# Sessions (ADR-0005): sliding idle timeout and absolute maximum, in days
HAALENDAR_SESSION_IDLE_DAYS=30
HAALENDAR_SESSION_ABSOLUTE_DAYS=90

# E-mail (verification, invitations). Without SMTP_HOST: development writes .eml files to MAIL_DIR
# (default: <system temp>/haalendar-mail); production sends nothing.
HAALENDAR_SMTP_HOST=
HAALENDAR_SMTP_PORT=587
# starttls | ssl | none
HAALENDAR_SMTP_SECURITY=starttls
HAALENDAR_SMTP_USERNAME=
HAALENDAR_SMTP_PASSWORD=
HAALENDAR_MAIL_FROM=Haalendar <no-reply@localhost>
HAALENDAR_MAIL_DIR=

# HTTP server
HAALENDAR_BIND_HOST=0.0.0.0
HAALENDAR_PORT=8080
# Comma-separated IPs of reverse proxies allowed to send X-Forwarded-* headers
HAALENDAR_FORWARDED_ALLOW_IPS=127.0.0.1

# Security baseline. The host of PUBLIC_URL and loopback names are always allowed; add others comma-separated.
HAALENDAR_EXTRA_ALLOWED_HOSTS=
# Origins allowed to send POST/PUT/PATCH/DELETE (the PUBLIC_URL origin is always allowed; the Vite dev server in development)
HAALENDAR_EXTRA_ALLOWED_ORIGINS=
# Per-client rate limit: sustained requests per minute (0 = off) and burst size
HAALENDAR_RATE_LIMIT_PER_MINUTE=600
HAALENDAR_RATE_LIMIT_BURST=120
# Stricter per-client limit for /api/v1/auth/* (login, registration, password reset)
HAALENDAR_AUTH_RATE_LIMIT_PER_MINUTE=20
HAALENDAR_AUTH_RATE_LIMIT_BURST=10
# Maximum request body in bytes (uploads have their own 10 MB limit)
HAALENDAR_MAX_REQUEST_BODY_BYTES=1048576

# Logging: DEBUG | INFO | WARNING | ERROR ; format json | console
HAALENDAR_LOG_LEVEL=INFO
HAALENDAR_LOG_FORMAT=json
# SQL statements slower than this many milliseconds are logged (0 = off; parameters are never logged)
HAALENDAR_DB_SLOW_QUERY_MS=200

# Prometheus metrics at GET /metrics — off by default; when on, scrape with "Authorization: Bearer <token>"
HAALENDAR_METRICS_ENABLED=false
# At least 24 characters. Example: openssl rand -hex 24
HAALENDAR_METRICS_TOKEN=

# Public demo instance (data reset every 30 minutes)
HAALENDAR_DEMO_MODE=false
