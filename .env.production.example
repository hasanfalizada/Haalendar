# +++===+++ 2026-11-01 — Hasan Alizada — HAAL-150. Settings of a Haalendar installation with compose.yaml. Copy to .env
# (never commit it), fill in every empty value, then `docker compose up -d`. Guide: docs/operations/deployment.md.
# Every other HAALENDAR_* setting of .env.example may be added here as well (rate limits, sessions, logging, metrics).

# +++===+++ 2026-11-01 — Hasan Alizada — HAAL-145. Another name when a second Haalendar (or anything else called
# "haalendar") runs on the same Docker host: containers, volumes and networks are named after it.
# COMPOSE_PROJECT_NAME=haalendar

# The image to run: a release tag (ghcr.io/hasanfalizada/haalendar:1.0.0) rather than latest, so upgrades are chosen.
HAALENDAR_IMAGE=ghcr.io/hasanfalizada/haalendar:latest

# The address people open; must be https:// (enables HSTS and secure cookies).
HAALENDAR_PUBLIC_URL=https://calendar.example.org
# Only with the bundled proxy (--profile proxy): the host of HAALENDAR_PUBLIC_URL; Caddy gets its certificate for it.
HAALENDAR_DOMAIN=calendar.example.org

# Random secrets — generate each one, e.g.: openssl rand -hex 32
HAALENDAR_SECRET_KEY=
# The first administrator is created in the browser at /setup with this token; it may be removed afterwards.
HAALENDAR_SETUP_TOKEN=
# Database passwords (letters and digits only — they are part of a URL): openssl rand -hex 24
POSTGRES_PASSWORD=
HAALENDAR_APP_DB_PASSWORD=

# E-mail for verification, invitations and password resets. Without SMTP_HOST no mail is sent.
HAALENDAR_SMTP_HOST=
HAALENDAR_SMTP_PORT=587
# starttls | ssl | none
HAALENDAR_SMTP_SECURITY=starttls
HAALENDAR_SMTP_USERNAME=
HAALENDAR_SMTP_PASSWORD=
HAALENDAR_MAIL_FROM="Haalendar <no-reply@calendar.example.org>"

# +++===+++ 2026-11-13 — Hasan Alizada — HAAL-177. Optional: where security problems with this installation are
# reported (mailto: or https: address), served as /.well-known/security.txt; without it there is none.
#HAALENDAR_SECURITY_CONTACT=mailto:security@calendar.example.org

# Where the app listens on this host without the bundled proxy (your reverse proxy forwards to it).
HAALENDAR_HTTP_BIND=127.0.0.1
HAALENDAR_HTTP_PORT=8080
# Ports of the bundled proxy.
HAALENDAR_HTTP_PUBLIC_PORT=80
HAALENDAR_HTTPS_PORT=443
# The Docker network of the app and the proxy; X-Forwarded-* headers are trusted from it only. Change it if it clashes.
HAALENDAR_WEB_SUBNET=172.30.250.0/24
# +++===+++ 2026-11-09 — Hasan Alizada — HAAL-155. backup.sh: where backups go and how many of the newest stay.
#HAALENDAR_BACKUP_DIR=./backups
#HAALENDAR_BACKUP_KEEP=14
