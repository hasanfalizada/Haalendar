# +++===+++ 2026-10-14 — Hasan Alizada — HAAL-006. Normalize line endings to LF in the repository regardless of contributor OS (Windows core.autocrlf), mark binaries explicitly.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files — no diff, no line-ending conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.pptx binary
*.woff binary
*.woff2 binary
*.db binary
*.sqlite binary
