# +++===+++ 2026-10-14 — Hasan Alizada — HAAL-006. Repository-wide ignore rules. Stack-specific rules are extended in the skeleton tasks (HAAL-016, HAAL-017).

# IDE / editors — personal settings are not shared; shared conventions live in .editorconfig and linter configs
.idea/
.vscode/
*.swp
*~
# +++===+++ 2026-11-10 — Hasan Alizada — Files AI assistants keep in a clone (allowed commands as they were typed, chat
# history, connections to services): they may carry a password from a command line. What agents should know about the
# project is in CLAUDE.md.
.claude/
.cursor/
.specstory/
.mcp.json

# OS
.DS_Store
Thumbs.db
desktop.ini

# Secrets and local environment — never commit; keep a documented .env.example instead
.env
.env.*
!.env.example
!.env.production.example
# +++===+++ 2026-11-01 — Hasan Alizada — HAAL-145. Local changes of an installation to compose.yaml.
compose.override.yaml
*.pem
*.key

# Logs
*.log
logs/

# Node.js / frontend
node_modules/
.next/
dist/
build/
coverage/
.cache/

# Python / backend
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Generated API client (ADR-0007: regenerated from api/openapi.yaml on every dev/build/check)
frontend/src/api/generated/

# Throw-away dev stack (scripts/dev/stack-up.sh): logs, uploads, mail
.dev/

# +++===+++ 2026-11-09 — Hasan Alizada — HAAL-155. Backups of an installation in a clone: passwords and all user data.
/backups/
