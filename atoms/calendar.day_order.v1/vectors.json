{
  "$comment": "+++===+++ 2026-10-22 — Hasan Alizada — HAAL-060. Test vectors for calendar.day_order.v1 (each expected order checked against an independent sort when written): all-day first, start times, continuing entries, case and accents, ties.",
  "atom": "calendar.day_order.v1",
  "cases": [
    {"name": "empty day", "input": {"entries": []}, "output": {"keys": []}},
    {"name": "all-day before timed", "input": {"entries": [{"key": "t", "all_day": false, "continues": false, "start": "09:00", "title": "Dentist", "created_at": "2026-10-01T10:00:00Z"}, {"key": "a", "all_day": true, "continues": false, "start": null, "title": "Birthday", "created_at": "2026-10-01T10:00:00Z"}]}, "output": {"keys": ["a", "t"]}},
    {"name": "timed by start time", "input": {"entries": [{"key": "d", "all_day": false, "continues": false, "start": "09:00", "title": "Dentist", "created_at": "2026-10-01T10:00:00Z"}, {"key": "c", "all_day": false, "continues": false, "start": "08:30", "title": "Call", "created_at": "2026-10-01T10:00:00Z"}, {"key": "l", "all_day": false, "continues": false, "start": "12:15", "title": "Lunch", "created_at": "2026-10-01T10:00:00Z"}]}, "output": {"keys": ["c", "d", "l"]}},
    {"name": "all-day among themselves by title, not by dates or colour", "input": {"entries": [{"key": "z", "all_day": true, "continues": false, "start": null, "title": "Zoo trip", "created_at": "2026-10-01T10:00:00Z"}, {"key": "a", "all_day": true, "continues": false, "start": null, "title": "anniversary", "created_at": "2026-10-01T10:00:00Z"}]}, "output": {"keys": ["a", "z"]}},
    {"name": "continuing entry first, before one at 00:00", "input": {"entries": [{"key": "b", "all_day": false, "continues": false, "start": "07:00", "title": "Breakfast", "created_at": "2026-10-01T10:00:00Z"}, {"key": "m", "all_day": false, "continues": false, "start": "00:00", "title": "Midnight run", "created_at": "2026-10-01T10:00:00Z"}, {"key": "f", "all_day": false, "continues": true, "start": null, "title": "Flight", "created_at": "2026-10-01T10:00:00Z"}]}, "output": {"keys": ["f", "m", "b"]}},
    {"name": "continuing entries among themselves by title", "input": {"entries": [{"key": "n", "all_day": false, "continues": true, "start": null, "title": "Night shift", "created_at": "2026-10-01T10:00:00Z"}, {"key": "f", "all_day": false, "continues": true, "start": null, "title": "Flight", "created_at": "2026-10-01T10:00:00Z"}]}, "output": {"keys": ["f", "n"]}},
    {"name": "same start: case does not count", "input": {"entries": [{"key": "b", "all_day": false, "continues": false, "start": "10:00", "title": "banana", "created_at": "2026-10-01T10:00:00Z"}, {"key": "a", "all_day": false, "continues": false, "start": "10:00", "title": "Apple", "created_at": "2026-10-01T10:00:00Z"}]}, "output": {"keys": ["a", "b"]}},
    {"name": "same start: accents do not count", "input": {"entries": [{"key": "ec", "all_day": false, "continues": false, "start": "10:00", "title": "Éclair", "created_at": "2026-10-01T10:00:00Z"}, {"key": "ea", "all_day": false, "continues": false, "start": "10:00", "title": "Eagle", "created_at": "2026-10-01T10:00:00Z"}]}, "output": {"keys": ["ea", "ec"]}},
    {"name": "same title key: code points decide", "input": {"entries": [{"key": "lo", "all_day": false, "continues": false, "start": "10:00", "title": "zoo", "created_at": "2026-10-01T10:00:00Z"}, {"key": "up", "all_day": false, "continues": false, "start": "10:00", "title": "Zoo", "created_at": "2026-10-01T10:00:00Z"}]}, "output": {"keys": ["up", "lo"]}},
    {"name": "same title: earlier created first", "input": {"entries": [{"key": "new", "all_day": false, "continues": false, "start": "09:00", "title": "Standup", "created_at": "2026-10-02T10:00:00Z"}, {"key": "old", "all_day": false, "continues": false, "start": "09:00", "title": "Standup", "created_at": "2026-10-01T10:00:00Z"}]}, "output": {"keys": ["old", "new"]}},
    {"name": "everything equal: key decides", "input": {"entries": [{"key": "k2", "all_day": false, "continues": false, "start": "09:00", "title": "Standup", "created_at": "2026-10-01T10:00:00Z"}, {"key": "k1", "all_day": false, "continues": false, "start": "09:00", "title": "Standup", "created_at": "2026-10-01T10:00:00Z"}]}, "output": {"keys": ["k1", "k2"]}},
    {"name": "start ignored when continuing", "input": {"entries": [{"key": "x", "all_day": false, "continues": true, "start": "23:00", "title": "A", "created_at": "2026-10-01T10:00:00Z"}, {"key": "y", "all_day": false, "continues": false, "start": "00:00", "title": "B", "created_at": "2026-10-01T10:00:00Z"}]}, "output": {"keys": ["x", "y"]}},
    {"name": "titles with digits and spaces", "input": {"entries": [{"key": "b", "all_day": false, "continues": false, "start": "10:00", "title": "Meeting 2", "created_at": "2026-10-01T10:00:00Z"}, {"key": "a", "all_day": false, "continues": false, "start": "10:00", "title": "Meeting 10", "created_at": "2026-10-01T10:00:00Z"}]}, "output": {"keys": ["a", "b"]}},
    {"name": "a full day", "input": {"entries": [{"key": "s", "all_day": false, "continues": false, "start": "09:30", "title": "Standup", "created_at": "2026-10-01T10:00:00Z"}, {"key": "h", "all_day": true, "continues": false, "start": null, "title": "Holiday", "created_at": "2026-10-01T10:00:00Z"}, {"key": "r", "all_day": false, "continues": true, "start": null, "title": "red flight", "created_at": "2026-10-01T10:00:00Z"}, {"key": "g", "all_day": false, "continues": false, "start": "18:00", "title": "gym", "created_at": "2026-10-01T10:00:00Z"}, {"key": "b", "all_day": true, "continues": false, "start": null, "title": "Birthday", "created_at": "2026-10-01T10:00:00Z"}, {"key": "c", "all_day": false, "continues": false, "start": "09:30", "title": "Call", "created_at": "2026-10-01T10:00:00Z"}]}, "output": {"keys": ["b", "h", "r", "c", "s", "g"]}}
  ]
}
