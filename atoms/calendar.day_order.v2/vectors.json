    {"name": "by time: continuing entry first, before one at 00:00", "input": {"by": "time", "entries": [{"key": "b", "all_day": false, "continues": false, "start": "07:00", "title": "Breakfast", "created_at": "2026-10-01T10:00:00Z", "color": "blue"}, {"key": "m", "all_day": false, "continues": false, "start": "00:00", "title": "Midnight run", "created_at": "2026-10-01T10:00:00Z", "color": "orange"}, {"key": "f", "all_day": false, "continues": true, "start": null, "title": "Flight", "created_at": "2026-10-01T10:00:00Z", "color": "brown"}]}, "output": {"keys": ["f", "m", "b"]}},
    {"name": "by time: continuing entries among themselves by title", "input": {"by": "time", "entries": [{"key": "n", "all_day": false, "continues": true, "start": null, "title": "Night shift", "created_at": "2026-10-01T10:00:00Z", "color": "black"}, {"key": "f", "all_day": false, "continues": true, "start": null, "title": "Flight", "created_at": "2026-10-01T10:00:00Z", "color": "blue"}]}, "output": {"keys": ["f", "n"]}},
