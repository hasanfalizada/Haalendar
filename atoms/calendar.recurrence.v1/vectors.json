{
  "$comment": "+++===+++ 2026-10-22 — Hasan Alizada — HAAL-066. Test vectors for calendar.recurrence.v1 (each expected output checked against a day-by-day expansion when written): short months, leap days, year boundaries, series started years ago, exceptions, window limits and unsupported rules.",
  "atom": "calendar.recurrence.v1",
  "cases": [
    {"name": "one-off inside the window", "input": {"start_date": "2026-10-22", "rrule": null, "exceptions": [], "from": "2026-10-01", "to": "2026-10-31"}, "output": {"dates": ["2026-10-22"]}},
    {"name": "one-off outside the window", "input": {"start_date": "2026-10-22", "rrule": null, "exceptions": [], "from": "2026-11-01", "to": "2026-11-30"}, "output": {"dates": []}},
    {"name": "daily from the start", "input": {"start_date": "2026-10-20", "rrule": "FREQ=DAILY", "exceptions": [], "from": "2026-10-18", "to": "2026-10-24"}, "output": {"dates": ["2026-10-20", "2026-10-21", "2026-10-22", "2026-10-23", "2026-10-24"]}},
    {"name": "daily without an excepted date", "input": {"start_date": "2026-10-20", "rrule": "FREQ=DAILY", "exceptions": ["2026-10-22"], "from": "2026-10-18", "to": "2026-10-24"}, "output": {"dates": ["2026-10-20", "2026-10-21", "2026-10-23", "2026-10-24"]}},
    {"name": "weekly keeps the weekday of the start", "input": {"start_date": "2026-10-22", "rrule": "FREQ=WEEKLY", "exceptions": [], "from": "2026-10-01", "to": "2026-11-30"}, "output": {"dates": ["2026-10-22", "2026-10-29", "2026-11-05", "2026-11-12", "2026-11-19", "2026-11-26"]}},
    {"name": "weekly across the year boundary", "input": {"start_date": "2026-12-28", "rrule": "FREQ=WEEKLY", "exceptions": [], "from": "2026-12-20", "to": "2027-01-20"}, "output": {"dates": ["2026-12-28", "2027-01-04", "2027-01-11", "2027-01-18"]}},
    {"name": "weekly series started years ago", "input": {"start_date": "2020-01-02", "rrule": "FREQ=WEEKLY", "exceptions": [], "from": "2026-10-19", "to": "2026-10-25"}, "output": {"dates": ["2026-10-22"]}},
    {"name": "monthly on the 31st skips short months", "input": {"start_date": "2026-01-31", "rrule": "FREQ=MONTHLY", "exceptions": [], "from": "2026-01-01", "to": "2026-12-31"}, "output": {"dates": ["2026-01-31", "2026-03-31", "2026-05-31", "2026-07-31", "2026-08-31", "2026-10-31", "2026-12-31"]}},
    {"name": "monthly on the 30th skips February", "input": {"start_date": "2026-01-30", "rrule": "FREQ=MONTHLY", "exceptions": [], "from": "2026-02-01", "to": "2026-04-30"}, "output": {"dates": ["2026-03-30", "2026-04-30"]}},
    {"name": "monthly series started years ago", "input": {"start_date": "2019-08-31", "rrule": "FREQ=MONTHLY", "exceptions": [], "from": "2026-09-01", "to": "2026-11-30"}, "output": {"dates": ["2026-10-31"]}},
    {"name": "yearly on 29 February skips common years", "input": {"start_date": "2024-02-29", "rrule": "FREQ=YEARLY", "exceptions": [], "from": "2025-01-01", "to": "2025-12-31"}, "output": {"dates": []}},
    {"name": "yearly on 29 February in a leap year", "input": {"start_date": "2024-02-29", "rrule": "FREQ=YEARLY", "exceptions": [], "from": "2028-01-01", "to": "2028-12-31"}, "output": {"dates": ["2028-02-29"]}},
    {"name": "yearly birthday", "input": {"start_date": "2020-05-09", "rrule": "FREQ=YEARLY", "exceptions": [], "from": "2026-01-01", "to": "2026-12-31"}, "output": {"dates": ["2026-05-09"]}},
    {"name": "window before the start", "input": {"start_date": "2026-10-22", "rrule": "FREQ=DAILY", "exceptions": [], "from": "2026-10-01", "to": "2026-10-21"}, "output": {"dates": []}},
    {"name": "window starting before the start", "input": {"start_date": "2026-10-22", "rrule": "FREQ=DAILY", "exceptions": [], "from": "2026-10-20", "to": "2026-10-23"}, "output": {"dates": ["2026-10-22", "2026-10-23"]}},
    {"name": "one-day window", "input": {"start_date": "2026-01-01", "rrule": "FREQ=DAILY", "exceptions": [], "from": "2026-10-22", "to": "2026-10-22"}, "output": {"dates": ["2026-10-22"]}},
    {"name": "an exception that is no occurrence is ignored", "input": {"start_date": "2026-10-22", "rrule": "FREQ=WEEKLY", "exceptions": ["2026-10-23"], "from": "2026-10-22", "to": "2026-10-29"}, "output": {"dates": ["2026-10-22", "2026-10-29"]}},
    {"name": "excepted first occurrence", "input": {"start_date": "2026-10-22", "rrule": "FREQ=WEEKLY", "exceptions": ["2026-10-22"], "from": "2026-10-22", "to": "2026-10-29"}, "output": {"dates": ["2026-10-29"]}},
    {"name": "daily through a leap day", "input": {"start_date": "2028-02-27", "rrule": "FREQ=DAILY", "exceptions": [], "from": "2028-02-27", "to": "2028-03-01"}, "output": {"dates": ["2028-02-27", "2028-02-28", "2028-02-29", "2028-03-01"]}},
    {"name": "weekly in the largest window (367 days)", "input": {"start_date": "2026-01-05", "rrule": "FREQ=WEEKLY", "exceptions": [], "from": "2026-01-01", "to": "2027-01-02"}, "output": {"dates": ["2026-01-05", "2026-01-12", "2026-01-19", "2026-01-26", "2026-02-02", "2026-02-09", "2026-02-16", "2026-02-23", "2026-03-02", "2026-03-09", "2026-03-16", "2026-03-23", "2026-03-30", "2026-04-06", "2026-04-13", "2026-04-20", "2026-04-27", "2026-05-04", "2026-05-11", "2026-05-18", "2026-05-25", "2026-06-01", "2026-06-08", "2026-06-15", "2026-06-22", "2026-06-29", "2026-07-06", "2026-07-13", "2026-07-20", "2026-07-27", "2026-08-03", "2026-08-10", "2026-08-17", "2026-08-24", "2026-08-31", "2026-09-07", "2026-09-14", "2026-09-21", "2026-09-28", "2026-10-05", "2026-10-12", "2026-10-19", "2026-10-26", "2026-11-02", "2026-11-09", "2026-11-16", "2026-11-23", "2026-11-30", "2026-12-07", "2026-12-14", "2026-12-21", "2026-12-28"]}},
    {"name": "rule with more parts is not supported in v1", "input": {"start_date": "2026-10-22", "rrule": "FREQ=WEEKLY;BYDAY=MO", "exceptions": [], "from": "2026-10-01", "to": "2026-10-31"}, "error": "UNSUPPORTED_RRULE"},
    {"name": "lower case is not the canonical form", "input": {"start_date": "2026-10-22", "rrule": "freq=daily", "exceptions": [], "from": "2026-10-01", "to": "2026-10-31"}, "error": "UNSUPPORTED_RRULE"},
    {"name": "empty rule is not a one-off", "input": {"start_date": "2026-10-22", "rrule": "", "exceptions": [], "from": "2026-10-01", "to": "2026-10-31"}, "error": "UNSUPPORTED_RRULE"},
    {"name": "RRULE prefix is not part of the value", "input": {"start_date": "2026-10-22", "rrule": "RRULE:FREQ=DAILY", "exceptions": [], "from": "2026-10-01", "to": "2026-10-31"}, "error": "UNSUPPORTED_RRULE"},
    {"name": "window ends before it starts", "input": {"start_date": "2026-10-22", "rrule": "FREQ=DAILY", "exceptions": [], "from": "2026-10-31", "to": "2026-10-01"}, "error": "INVALID_WINDOW"},
    {"name": "window longer than 367 days", "input": {"start_date": "2026-10-22", "rrule": "FREQ=DAILY", "exceptions": [], "from": "2026-01-01", "to": "2027-01-03"}, "error": "WINDOW_TOO_LARGE"}
  ]
}
