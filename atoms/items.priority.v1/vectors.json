            "tiebreak": 1
          },
          {
            "id": "b",
            "priority": "high",
            "tiebreak": 3
          },
          {
            "id": "c",
            "priority": null,
            "tiebreak": 2
          },
          {
            "id": "d",
            "priority": "high",
            "tiebreak": 1
          },
          {
            "id": "e",
            "priority": "medium",
            "tiebreak": 2
          }
        ],
        "allowed": [
          "low",
