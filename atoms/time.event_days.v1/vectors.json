{
  "$comment": "+++===+++ 2026-10-15 — Hasan Alizada — HAAL-169. Test vectors for time.event_days.v1 (Python and TypeScript implementations must pass all).",
  "atom": "time.event_days.v1",
  "cases": [
    {
      "name": "all-day event keeps its date everywhere",
      "input": {
        "event": {
          "all_day": true,
          "start_time": null,
          "end_time": null,
          "start_date": "2026-05-09",
          "end_date": "2026-05-09",
          "tzid": "Europe/Berlin"
        },
        "viewer_tzid": "Pacific/Kiritimati"
      },
      "output": {
        "first_day": "2026-05-09",
        "last_day": "2026-05-09"
      }
    },
    {
