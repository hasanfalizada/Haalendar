      },
      "output": {
        "utc": "2026-05-01T04:15:00Z",
        "offset_minutes": 345,
        "resolution": "exact"
      }
    },
    {
      "name": "leap day",
      "input": {
        "date": "2028-02-29",
        "time": "12:00",
        "tzid": "UTC"
