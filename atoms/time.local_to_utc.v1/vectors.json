{
  "$comment": "+++===+++ 2026-10-15 — Hasan Alizada — HAAL-169. Test vectors for time.local_to_utc.v1 (tz rules of tzdata 2026.5; Python and TypeScript implementations must pass all).",
  "atom": "time.local_to_utc.v1",
  "cases": [
    {
      "name": "winter time in Berlin",
      "input": {
        "date": "2026-01-15",
        "time": "09:30",
        "tzid": "Europe/Berlin"
      },
      "output": {
        "utc": "2026-01-15T08:30:00Z",
        "offset_minutes": 60,
        "resolution": "exact"
      }
    },
    {
      "name": "summer time in Berlin",
      "input": {
        "date": "2026-07-15",
        "time": "09:30",
        "tzid": "Europe/Berlin"
      },
      "output": {
        "utc": "2026-07-15T07:30:00Z",
        "offset_minutes": 120,
        "resolution": "exact"
      }
    },
    {
      "name": "spring-forward gap moves forward (Berlin 02:30 does not exist)",
      "input": {
        "date": "2026-03-29",
        "time": "02:30",
        "tzid": "Europe/Berlin"
      },
      "output": {
        "utc": "2026-03-29T01:30:00Z",
        "offset_minutes": 60,
        "resolution": "gap_shifted"
      }
    },
    {
      "name": "last minute before the gap",
      "input": {
        "date": "2026-03-29",
        "time": "01:59",
        "tzid": "Europe/Berlin"
      },
      "output": {
        "utc": "2026-03-29T00:59:00Z",
        "offset_minutes": 60,
        "resolution": "exact"
      }
    },
    {
      "name": "first minute after the gap",
      "input": {
        "date": "2026-03-29",
        "time": "03:00",
        "tzid": "Europe/Berlin"
      },
      "output": {
        "utc": "2026-03-29T01:00:00Z",
        "offset_minutes": 120,
        "resolution": "exact"
      }
    },
    {
      "name": "fall-back overlap takes the first occurrence (Berlin 02:30 twice)",
      "input": {
        "date": "2026-10-25",
        "time": "02:30",
        "tzid": "Europe/Berlin"
      },
      "output": {
        "utc": "2026-10-25T00:30:00Z",
        "offset_minutes": 120,
        "resolution": "overlap_first"
      }
    },
    {
      "name": "after the overlap",
      "input": {
        "date": "2026-10-25",
        "time": "03:00",
        "tzid": "Europe/Berlin"
      },
      "output": {
        "utc": "2026-10-25T02:00:00Z",
        "offset_minutes": 60,
        "resolution": "exact"
      }
    },
    {
      "name": "New York gap",
      "input": {
        "date": "2026-03-08",
        "time": "02:15",
        "tzid": "America/New_York"
      },
      "output": {
        "utc": "2026-03-08T07:15:00Z",
        "offset_minutes": -300,
        "resolution": "gap_shifted"
      }
    },
    {
      "name": "New York overlap",
      "input": {
        "date": "2026-11-01",
        "time": "01:30",
        "tzid": "America/New_York"
      },
      "output": {
        "utc": "2026-11-01T05:30:00Z",
        "offset_minutes": -240,
        "resolution": "overlap_first"
      }
    },
    {
      "name": "Baku has no DST",
      "input": {
        "date": "2026-07-01",
        "time": "00:00",
        "tzid": "Asia/Baku"
      },
      "output": {
        "utc": "2026-06-30T20:00:00Z",
        "offset_minutes": 240,
        "resolution": "exact"
      }
    },
    {
      "name": "local midnight becomes the previous UTC day",
      "input": {
        "date": "2026-01-01",
        "time": "00:30",
        "tzid": "Asia/Tokyo"
      },
      "output": {
        "utc": "2025-12-31T15:30:00Z",
        "offset_minutes": 540,
        "resolution": "exact"
      }
    },
    {
      "name": "negative offset crosses into the next UTC day",
      "input": {
        "date": "2026-12-31",
        "time": "22:00",
        "tzid": "America/Los_Angeles"
      },
      "output": {
        "utc": "2027-01-01T06:00:00Z",
