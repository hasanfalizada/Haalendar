{
  "name": "haalendar-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "+++===+++ 2026-10-14 — Hasan Alizada — HAAL-017. Haalendar web app (React + Vite SPA, ADR-0003). The API client is generated from ../api/openapi.yaml before every dev/build/check run.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "gen:api": "openapi-ts",
    "dev": "pnpm gen:api && vite",
    "build": "pnpm gen:api && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm gen:api && vitest run",
    "check": "pnpm gen:api && tsc -b && eslint . && prettier --check . && vitest run",
    "mock:api": "pnpm dlx @stoplight/prism-cli@5.16.0 mock -d -p 4010 ../api/openapi.yaml"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "1.170.41",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "i18next": "26.4.2",
    "lucide-react": "1.52.0",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.16",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@hey-api/openapi-ts": "0.99.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.42",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
